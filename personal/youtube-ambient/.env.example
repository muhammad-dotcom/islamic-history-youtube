# Copy this to .env and fill in your values

# Anthropic — used for title/description generation
ANTHROPIC_API_KEY=sk-ant-...

# YouTube OAuth2 — download from Google Cloud Console
# See plans/phase1-pipeline.md for setup steps
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# Output directories
OUTPUT_DIR=output
VISUALS_DIR=data/visuals

# Pipeline defaults (override per-run with CLI flags)
DEFAULT_DURATION_HOURS=8
DEFAULT_SOUND_TYPE=brown

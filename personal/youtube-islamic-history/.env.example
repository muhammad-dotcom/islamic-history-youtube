# Copy this file to .env and fill in your keys

# Anthropic (reuse from youtube-ambient)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — sign up at elevenlabs.io
ELEVENLABS_API_KEY=
# Pick a voice from elevenlabs.io/voice-lab and paste its ID here
# Good documentary voices: search "narrator" or "documentary" in their library
ELEVENLABS_VOICE_ID=

# Higgsfield — sign up at higgsfield.ai, get your API key from dashboard
HIGGSFIELD_API_KEY=

# OpenAI — optional, only needed if Higgsfield API is unavailable (DALL-E 3 fallback)
OPENAI_API_KEY=

# YouTube OAuth — copy client_secrets.json from Google Cloud Console into this folder
# then run: python scripts/setup_youtube_auth.py
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json
